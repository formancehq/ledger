# Compiler — instruments the ledger service for Antithesis coverage
FROM golang:1.27-trixie AS compiler
# nats is included so the NATS event-sink implementation actually exists in
# the tested binary: the workload's parallel_driver_event_sinks creates NATS
# sinks against the nats container started by the Antithesis config.
# enable_antithesis_sdk is what arms the SDK: the pinned
# v0.8.0-default-no-op build compiles assert, lifecycle, random and
# instrumentation to no-ops unless this tag is set. Without it this image would
# run with an empty assertion catalog and report no violations because nothing
# was ever registered — a silent pass. This is the only image that sets it.
ARG BUILD_TAGS="s3,nats,enable_antithesis_sdk"

RUN apt-get update && apt-get install -y bash git gcc

# Must match the SDK pinned in go.mod: the 0.8.0 line added a column
# parameter to assert.AssertRaw, which is what the generated catalog calls.
RUN go install github.com/antithesishq/antithesis-sdk-go/tools/antithesis-go-instrumentor@v0.8.0-default-no-op

WORKDIR /src
COPY go.mod go.sum ./
COPY main.go .
COPY internal internal
COPY cmd cmd
COPY pkg pkg

RUN mkdir /instrumented
# -instrumentor_version pins the SDK the generated notifier module requires.
# It defaults to the instrumentor's own SDK_Version ("0.8.0"), and stable
# v0.8.0 outranks the v0.8.0-default-no-op prerelease in module resolution —
# so without this flag the instrumented build silently resolves to the stable,
# live-by-default SDK and enable_antithesis_sdk becomes inert here.
RUN antithesis-go-instrumentor -instrumentor_version v0.8.0-default-no-op . /instrumented

WORKDIR /instrumented/customer
RUN go build -race -tags "${BUILD_TAGS}" -o /ledger-server .
RUN go build -race -tags "${BUILD_TAGS}" -o /ledgerctl ./cmd/ledgerctl

# Runner
FROM debian:trixie
RUN apt-get update && apt-get install -y ca-certificates tzdata && rm -rf /var/lib/apt/lists/*
ENV TZ=UTC
ENV PATH=$PATH:/app
WORKDIR /app
COPY --from=compiler /ledger-server .
COPY --from=compiler /ledgerctl .
COPY --from=compiler /instrumented/symbols/ /symbols/
ENTRYPOINT ["./ledger-server"]

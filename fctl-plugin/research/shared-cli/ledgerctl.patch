+++ b/cmd/ledgerctl/shared_poc_test.go
@@ -0,0 +1,171 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/formancehq/fctl/pkg/pluginsdk"
+	"github.com/formancehq/ledger/v3/internal/proto/commonpb"
+	"github.com/formancehq/ledger/v3/internal/proto/servicepb"
+)
+
+type sharedPOCFixture struct {
+	servicepb.UnimplementedBucketServiceServer
+	partial bool
+}
+
+func (f *sharedPOCFixture) ListLedgers(_ *servicepb.ListLedgersRequest, stream grpc.ServerStreamingServer[commonpb.LedgerInfo]) error {
+	if err := stream.Send(&commonpb.LedgerInfo{Name: "books"}); err != nil {
+		return err
+	}
+	if f.partial {
+		return status.Error(codes.Internal, "fixture stream failed after one row")
+	}
+	return nil
+}
+
+func TestSharedPOCGRPCReadAndPartialResult(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		t.Run(map[bool]string{false: "complete", true: "partial"}[partial], func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := grpc.NewServer()
+			servicepb.RegisterBucketServiceServer(server, &sharedPOCFixture{partial: partial})
+			t.Cleanup(server.Stop)
+			go func() { _ = server.Serve(listener) }()
+			out, err := captureSharedPOC(t, t.Context(), "--shared-command-poc", "--server", listener.Addr().String(), "--insecure", "--auth-token", "fixture", "ledgers", "list", "--json")
+			if (err != nil) != partial {
+				t.Fatalf("partial=%v error=%v", partial, err)
+			}
+			var ledgers map[string]json.RawMessage
+			if json.Unmarshal(out, &ledgers) != nil || ledgers["books"] == nil {
+				t.Fatalf("partial payload lost or stdout contaminated: %q", out)
+			}
+			if partial && status.Code(err) != codes.Internal {
+				t.Fatalf("error category lost: %v", err)
+			}
+			if !partial {
+				original, err := captureSharedPOC(t, t.Context(), "--server", listener.Addr().String(), "--insecure", "--auth-token", "fixture", "ledgers", "list", "--json")
+				if err != nil {
+					t.Fatal(err)
+				}
+				var nativeValue, sharedValue any
+				originalDecoder := json.NewDecoder(bytes.NewReader(original))
+				originalDecoder.UseNumber()
+				sharedDecoder := json.NewDecoder(bytes.NewReader(out))
+				sharedDecoder.UseNumber()
+				if originalDecoder.Decode(&nativeValue) != nil || sharedDecoder.Decode(&sharedValue) != nil {
+					t.Fatal("invalid JSON projection")
+				}
+				canonicalOriginal, err := json.Marshal(nativeValue)
+				if err != nil {
+					t.Fatal(err)
+				}
+				canonicalShared, err := json.Marshal(sharedValue)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !bytes.Equal(canonicalOriginal, canonicalShared) {
+					t.Fatalf("native JSON contract changed: original=%s shared=%s", original, out)
+				}
+			}
+		})
+	}
+}
+
+func TestSharedPOCBodySourcesAndExactNumbers(t *testing.T) {
+	const body = `{"metadata":{"amount":9007199254740993}}`
+	path := filepath.Join(t.TempDir(), "body.json")
+	if err := os.WriteFile(path, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for _, value := range []string{body, "@" + path, "-"} {
+		cmd := newRootCommand()
+		cmd.SetIn(strings.NewReader(body))
+		got, err := readSharedPOCBody(cmd, value)
+		if err != nil || string(got) != body {
+			t.Fatalf("input %q changed: %q %v", value, got, err)
+		}
+		request := pluginsdk.ExecuteRequest{Args: []string{"books"}, Body: got}
+		create, err := sharedPOCCreateLedger(request)
+		if err != nil {
+			t.Fatal(err)
+		}
+		encoded, err := json.Marshal(&commonpb.MetadataMap{Values: create.Metadata})
+		if err != nil || !bytes.Contains(encoded, []byte("9007199254740993")) {
+			t.Fatalf("metadata precision lost: %s %v", encoded, err)
+		}
+	}
+}
+
+func TestSharedPOCTransactionWirePrecision(t *testing.T) {
+	const body = `{"postings":[{"source":"world","destination":"users:001","asset":"USD/2","amount":9007199254740993}],"metadata":{"number":9007199254740993}}`
+	var payload servicepb.CreateTransactionPayload
+	if err := json.Unmarshal([]byte(body), &payload); err != nil {
+		t.Fatal(err)
+	}
+	if payload.GetPostings()[0].GetAmount().Dec() != "9007199254740993" {
+		t.Fatal("gRPC posting amount changed")
+	}
+	encoded, err := json.Marshal(&payload)
+	if err != nil || bytes.Count(encoded, []byte("9007199254740993")) != 2 {
+		t.Fatalf("transaction precision changed: %s %v", encoded, err)
+	}
+}
+
+func TestSharedPOCCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	out, err := captureSharedPOC(t, ctx, "--shared-command-poc", "--server", "127.0.0.1:1", "--insecure", "ledgers", "list", "--json")
+	if !errors.Is(err, context.Canceled) || len(out) != 0 {
+		t.Fatalf("canceled command: %q %v", out, err)
+	}
+}
+
+func TestSharedPOCRejectsAllUnsupportedOptionsBeforeRPC(t *testing.T) {
+	for _, args := range [][]string{{"ledgers", "list", "--page-size", "1"}, {"ledgers", "list", "--checkpoint-id", "123"}, {"ledgers", "create", "--name", "books", "--mirror-dsn", "unused"}} {
+		out, err := captureSharedPOC(t, t.Context(), append([]string{"--shared-command-poc", "--server", "127.0.0.1:1", "--insecure"}, args...)...)
+		if err == nil || !strings.Contains(err.Error(), "outside the isolated prototype") || len(out) != 0 {
+			t.Fatalf("unsupported option reached RPC: %q %v", out, err)
+		}
+	}
+}
+
+func captureSharedPOC(t *testing.T, ctx context.Context, args ...string) ([]byte, error) {
+	t.Helper()
+	// The native ledgerctl encoder writes to os.Stdout, so capture the actual
+	// host boundary rather than assuming Cobra's injected writer is used.
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	previous := os.Stdout
+	os.Stdout = write
+	defer func() { os.Stdout = previous; _ = read.Close(); _ = write.Close() }()
+	cmd := newRootCommand()
+	cmd.SetArgs(args)
+	cmd.SetErr(io.Discard)
+	err = cmd.ExecuteContext(ctx)
+	if closeErr := write.Close(); closeErr != nil {
+		t.Fatal(closeErr)
+	}
+	out, readErr := io.ReadAll(read)
+	if readErr != nil {
+		t.Fatal(readErr)
+	}
+	return out, err
+}

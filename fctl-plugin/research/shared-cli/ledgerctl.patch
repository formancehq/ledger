+package cmdutil
+
+// MarshalSharedPOC exposes the existing native projection to the isolated
+// experiment. It performs no terminal IO and preserves ledgerctl JSON shapes.
+func MarshalSharedPOC(data any) ([]byte, error) { return marshalJSON(data) }

@@ -0,0 +1,326 @@
+package main
+
+// This file is an isolated feasibility adapter, enabled only by
+// --shared-command-poc. Existing ledgerctl handlers remain the default.
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"github.com/pterm/pterm"
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+	"golang.org/x/term"
+
+	"github.com/formancehq/fctl/pkg/pluginsdk"
+	ledgerplugin "github.com/formancehq/ledger/fctl-plugin"
+	"github.com/formancehq/ledger/v3/cmd/ledgerctl/cmdutil"
+	"github.com/formancehq/ledger/v3/internal/proto/commonpb"
+	"github.com/formancehq/ledger/v3/internal/proto/servicepb"
+)
+
+func attachSharedPOC(root *cobra.Command) {
+	root.PersistentFlags().Bool("shared-command-poc", false, "Use the isolated shared-command experiment")
+	for _, path := range [][]string{{"ledgers", "list"}, {"ledgers", "create"}, {"transactions", "create"}} {
+		cmd, _, err := root.Find(path)
+		if err != nil || cmd.RunE == nil {
+			panic("missing prototype command")
+		}
+		original := cmd.RunE
+		if path[1] == "create" {
+			cmd.Flags().String("data", "", "Prototype JSON body, @file or - for stdin")
+		}
+		if path[0] == "transactions" {
+			cmd.Flags().String("idempotency-key", "", "Prototype mutation idempotency key")
+		}
+		cmd.RunE = func(cmd *cobra.Command, args []string) error {
+			enabled, err := cmd.Flags().GetBool("shared-command-poc")
+			if err != nil {
+				return err
+			}
+			if !enabled {
+				return original(cmd, args)
+			}
+			return runSharedPOC(cmd, path)
+		}
+	}
+}
+
+func runSharedPOC(cmd *cobra.Command, path []string) error {
+	allowed := map[string]bool{"shared-command-poc": true, "server": true, "profile": true, "insecure": true, "tls-ca-cert": true, "tls-server-name": true, "signing-key": true, "signing-key-id": true, "response-verify-key": true, "auth-token": true, "result-file": true, "consistency": true, "json": true, "yaml": true, "timeout": true, "ledger": true, "name": true, "data": true, "idempotency-key": true}
+	var unsupported string
+	check := func(flag *pflag.Flag) {
+		if !allowed[flag.Name] {
+			unsupported = flag.Name
+		}
+	}
+	cmd.Flags().Visit(check)
+	cmd.InheritedFlags().Visit(check)
+	if unsupported != "" {
+		return fmt.Errorf("--%s is outside the isolated prototype; use the original handler", unsupported)
+	}
+	req := pluginsdk.ExecuteRequest{CommandPath: []string{"ledger", path[1]}, Flags: map[string]string{}, ChangedFlags: map[string]bool{}}
+	if path[0] == "transactions" {
+		req.CommandPath = []string{"ledger", "transactions", "create"}
+	}
+	if path[1] == "create" {
+		bodyFlag, err := cmd.Flags().GetString("data")
+		if err != nil {
+			return err
+		}
+		if path[0] == "ledgers" {
+			name, err := cmd.Flags().GetString("name")
+			if err != nil {
+				return err
+			}
+			if name == "" {
+				if !term.IsTerminal(int(os.Stdin.Fd())) {
+					return errors.New("ledger name is required (use --name flag)")
+				}
+				// The host owns the prompt. The shared executor receives its value.
+				manifest, err := ledgerplugin.NewWithExecutor("3.0.0", nil).GetManifest(cmd.Context())
+				if err != nil {
+					return err
+				}
+				spec, err := pluginsdk.FindCommand(manifest, []string{"ledger", "create"})
+				if err != nil {
+					return err
+				}
+				if len(spec.Inputs) == 0 {
+					return errors.New("shared manifest has no ledger name field")
+				}
+				if _, err := fmt.Fprintf(cmd.ErrOrStderr(), "%s: ", spec.Inputs[0].Title); err != nil {
+					return err
+				}
+				// Unlike the current native pterm reader, this adapter sends its
+				// prompt explicitly to stderr and consumes host-provided stdin.
+				name, err = bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+				name = strings.TrimSpace(name)
+				if err != nil {
+					return err
+				}
+			}
+			req.Args = []string{name}
+			if bodyFlag == "" {
+				bodyFlag = "{}"
+			}
+		} else {
+			ledger, err := cmd.Flags().GetString("ledger")
+			if err != nil {
+				return err
+			}
+			req.Flags["ledger"] = ledger
+			if bodyFlag == "" {
+				return errors.New("the transaction prototype requires --data; legacy --posting and --script stay in the original handler")
+			}
+		}
+		body, err := readSharedPOCBody(cmd, bodyFlag)
+		if err != nil {
+			return err
+		}
+		req.Body = body
+		req.Flags["data"] = bodyFlag
+		req.ChangedFlags["data"] = true
+		key, err := cmd.Flags().GetString("idempotency-key")
+		if err != nil {
+			return err
+		}
+		req.Flags["idempotency-key"] = key
+	}
+	shared := ledgerplugin.NewWithExecutor("3.0.0", func(ctx context.Context, request pluginsdk.ExecuteRequest) (pluginsdk.ExecuteResponse, error) {
+		return executeSharedGRPC(ctx, cmd, request)
+	})
+	response, executeErr := shared.Execute(cmd.Context(), req)
+	if len(response.Data) != 0 {
+		if err := renderSharedPOC(cmd, path, response.Data); err != nil {
+			return errors.Join(executeErr, err)
+		}
+	}
+	return executeErr
+}
+
+func readSharedPOCBody(cmd *cobra.Command, value string) (json.RawMessage, error) {
+	var input io.Reader = strings.NewReader(value)
+	if value == "-" {
+		input = cmd.InOrStdin()
+	}
+	if strings.HasPrefix(value, "@") {
+		file, err := os.Open(strings.TrimPrefix(value, "@"))
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = file.Close() }()
+		input = file
+	}
+	body, err := io.ReadAll(io.LimitReader(input, (4<<20)+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(body) > 4<<20 {
+		return nil, errors.New("JSON body exceeds 4 MiB")
+	}
+	return body, nil
+}
+
+func executeSharedGRPC(ctx context.Context, cmd *cobra.Command, request pluginsdk.ExecuteRequest) (pluginsdk.ExecuteResponse, error) {
+	client, conn, err := cmdutil.GetClient(cmd)
+	if err != nil {
+		return pluginsdk.ExecuteResponse{}, err
+	}
+	defer func() { _ = conn.Close() }()
+	callCtx, cancel := cmdutil.GetContext(cmd)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return pluginsdk.ExecuteResponse{}, err
+	}
+	switch strings.Join(request.CommandPath, "/") {
+	case "ledger/list":
+		stream, err := client.ListLedgers(callCtx, &servicepb.ListLedgersRequest{})
+		if err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		var ledgers []*commonpb.LedgerInfo
+		for {
+			ledger, err := stream.Recv()
+			if errors.Is(err, io.EOF) {
+				return sharedPOCResponse(ledgers, nil)
+			}
+			if err != nil {
+				return sharedPOCResponse(ledgers, err)
+			}
+			ledgers = append(ledgers, ledger)
+		}
+	case "ledger/create":
+		create, err := sharedPOCCreateLedger(request)
+		if err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		apply, err := cmdutil.BuildApplyRequestWithIdempotencyKey(cmd, request.Flags["idempotency-key"], &servicepb.Request{Type: &servicepb.Request_CreateLedger{CreateLedger: create}})
+		if err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		response, err := client.Apply(callCtx, apply)
+		if err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		if err := cmdutil.VerifyResponseSignatures(cmd, response.GetLogs()); err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		if len(response.GetLogs()) != 1 || response.GetLogs()[0].GetPayload().GetCreateLedger() == nil {
+			return pluginsdk.ExecuteResponse{}, errors.New("unexpected ledger creation response")
+		}
+		return sharedPOCResponse(response.GetLogs()[0].GetPayload().GetCreateLedger().ToLedgerInfo(), nil)
+	case "ledger/transactions/create":
+		payload := &servicepb.CreateTransactionPayload{}
+		if err := json.Unmarshal(request.Body, payload); err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		apply, err := cmdutil.BuildApplyRequestWithIdempotencyKey(cmd, request.Flags["idempotency-key"], &servicepb.Request{Type: &servicepb.Request_Apply{Apply: &servicepb.LedgerApplyRequest{Ledger: request.Flags["ledger"], Action: &servicepb.LedgerAction{Data: &servicepb.LedgerAction_CreateTransaction{CreateTransaction: payload}}}}})
+		if err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		response, err := client.Apply(callCtx, apply)
+		if err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		if err := cmdutil.VerifyResponseSignatures(cmd, response.GetLogs()); err != nil {
+			return pluginsdk.ExecuteResponse{}, err
+		}
+		if len(response.GetLogs()) != 1 || response.GetLogs()[0].GetPayload().GetApply().GetLog().GetData().GetCreatedTransaction() == nil {
+			return pluginsdk.ExecuteResponse{}, errors.New("unexpected transaction creation response")
+		}
+		return sharedPOCResponse(response.GetLogs()[0].GetPayload().GetApply().GetLog().GetData().GetCreatedTransaction(), nil)
+	default:
+		return pluginsdk.ExecuteResponse{}, errors.New("command is outside the three-operation prototype")
+	}
+}
+
+func sharedPOCCreateLedger(request pluginsdk.ExecuteRequest) (*servicepb.CreateLedgerRequest, error) {
+	var body struct {
+		Metadata               *commonpb.MetadataMap `json:"metadata"`
+		DefaultEnforcementMode string                `json:"defaultEnforcementMode"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(request.Body))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&body); err != nil {
+		return nil, err
+	}
+	mode := commonpb.ChartEnforcementMode_CHART_ENFORCEMENT_STRICT
+	switch body.DefaultEnforcementMode {
+	case "", "STRICT", "CHART_ENFORCEMENT_STRICT":
+	case "AUDIT", "CHART_ENFORCEMENT_AUDIT":
+		mode = commonpb.ChartEnforcementMode_CHART_ENFORCEMENT_AUDIT
+	default:
+		return nil, errors.New("invalid default enforcement mode")
+	}
+	name := request.Flags["ledger"]
+	if len(request.Args) == 1 {
+		name = request.Args[0]
+	}
+	return &servicepb.CreateLedgerRequest{Name: name, Metadata: body.Metadata.GetValues(), DefaultEnforcementMode: mode}, nil
+}
+
+func sharedPOCResponse(data any, executeErr error) (pluginsdk.ExecuteResponse, error) {
+	projection, err := cmdutil.MarshalSharedPOC(data)
+	if err != nil {
+		return pluginsdk.ExecuteResponse{}, errors.Join(executeErr, err)
+	}
+	encoded, err := json.Marshal(map[string]json.RawMessage{"data": projection})
+	return pluginsdk.ExecuteResponse{Data: encoded}, errors.Join(executeErr, err)
+}
+
+func renderSharedPOC(cmd *cobra.Command, path []string, data json.RawMessage) error {
+	var envelope struct {
+		Data json.RawMessage `json:"data"`
+	}
+	if err := json.Unmarshal(data, &envelope); err != nil {
+		return err
+	}
+	result := envelope.Data
+	if path[1] == "list" {
+		var ledgers []struct {
+			Name string `json:"name"`
+		}
+		if err := json.Unmarshal(result, &ledgers); err != nil {
+			return err
+		}
+		var records []json.RawMessage
+		if err := json.Unmarshal(result, &records); err != nil {
+			return err
+		}
+		legacy := make(map[string]json.RawMessage, len(ledgers))
+		for i, ledger := range ledgers {
+			legacy[ledger.Name] = records[i]
+		}
+		encoded, err := json.Marshal(legacy)
+		if err != nil {
+			return err
+		}
+		result = encoded
+	}
+	if handled, err := cmdutil.EncodeStructured(cmd, result); handled || err != nil {
+		return err
+	}
+	// Human presentation stays host-specific and does not enter the executor.
+	pterm.DefaultSection.Println("Shared command prototype")
+	if path[1] == "list" {
+		var ledgers map[string]json.RawMessage
+		if err := json.Unmarshal(result, &ledgers); err != nil {
+			return err
+		}
+		table := pterm.TableData{{"NAME"}}
+		for name := range ledgers {
+			table = append(table, []string{name})
+		}
+		return pterm.DefaultTable.WithHasHeader().WithData(table).Render()
+	}
+	pterm.Println(fmt.Sprintf("%s", result))
+	return nil
+}
diff --git a/cmd/ledgerctl/shared_poc_test.go b/cmd/ledgerctl/shared_poc_test.go

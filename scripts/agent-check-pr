#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: AI_REVIEW_BASE_SHA=<commit> bash scripts/agent-check-pr [--list|--normalize]

Runs fast local checks selected from the exact base-to-worktree diff.
--list prints the selected gates without executing them. --normalize runs only
the applicable deterministic generation/tidy/lint pass.
EOF
}

mode=run
case "${1:-}" in
    "") ;;
    --list) mode=list ;;
    --normalize) mode=normalize ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        echo "agent-check-pr: unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
esac

base_sha=${AI_REVIEW_BASE_SHA:-}
if [[ -z "$base_sha" ]]; then
    echo "agent-check-pr: AI_REVIEW_BASE_SHA is required" >&2
    exit 1
fi

# Exact candidate/worktree identity remains a publication boundary. Cache
# sharing changes no part of this binding contract.
binding_names=(EXPECTED_PR_NUMBER EXPECTED_WORKTREE EXPECTED_HEAD AI_WORKTREE_PR AI_WORKTREE_PATH AI_WORKTREE_EXPECTED_HEAD TRUSTED_ROOT_CHECKOUT)
binding_declared=false
for name in "${binding_names[@]}"; do
    if [[ -n "${!name:-}" ]]; then
        binding_declared=true
        break
    fi
done
if [[ "$binding_declared" == true ]]; then
    for name in "${binding_names[@]}"; do
        [[ -n "${!name:-}" ]] || { echo "WORKTREE_BINDING_GATE=FAIL (missing $name)" >&2; exit 1; }
    done
    candidate_root=$(cd "$EXPECTED_WORKTREE" 2>/dev/null && pwd -P) || {
        echo "WORKTREE_BINDING_GATE=FAIL (invalid EXPECTED_WORKTREE)" >&2
        exit 1
    }
    current_root=$(git rev-parse --show-toplevel)
    current_root=$(cd "$current_root" && pwd -P)
    trusted_root=$(cd "$TRUSTED_ROOT_CHECKOUT" 2>/dev/null && pwd -P) || {
        echo "WORKTREE_BINDING_GATE=FAIL (invalid TRUSTED_ROOT_CHECKOUT)" >&2
        exit 1
    }
    [[ "$candidate_root" != "$trusted_root" ]] || { echo "ROOT_CHECKOUT_AS_CANDIDATE_FORBIDDEN" >&2; exit 1; }
    [[ "$current_root" == "$candidate_root" && "$AI_WORKTREE_PATH" == "$candidate_root" ]] || {
        echo "WORKTREE_BINDING_GATE=FAIL (validator cwd/worktree mismatch)" >&2
        exit 1
    }
    [[ "$EXPECTED_PR_NUMBER" == "$AI_WORKTREE_PR" ]] || { echo "CROSS_PR_WORKTREE_CONTAMINATION" >&2; exit 1; }
    current_head=$(git rev-parse HEAD)
    [[ "$current_head" == "$EXPECTED_HEAD" && "$current_head" == "$AI_WORKTREE_EXPECTED_HEAD" ]] || {
        echo "WORKTREE_BINDING_GATE=FAIL (validator HEAD mismatch)" >&2
        exit 1
    }
    echo "WORKTREE_BINDING_GATE=PASS role=validation pr=$EXPECTED_PR_NUMBER path=$candidate_root head=$current_head" >&2
fi

if ! git cat-file -e "${base_sha}^{commit}" 2>/dev/null; then
    echo "agent-check-pr: invalid review base commit: $base_sha" >&2
    exit 1
fi

needs_precommit=false
needs_full=false
needs_tooling=false
needs_e2e=false
needs_scenarios=false
needs_schemathesis=false
needs_operator=false
has_change=false
changed_packages=()

append_package() {
    local package=$1
    local existing
    for existing in "${changed_packages[@]}"; do
        [[ "$existing" == "$package" ]] && return
    done
    changed_packages+=("$package")
}

classify_path() {
    local status=$1
    local path=$2
    has_change=true

    case "$status" in
        A|D|M) ;;
        *) needs_full=true ;;
    esac

    case "$path" in
        docs/*|README.md|CONTRIBUTING.md|LICENSE|LICENSE.md)
            return
            ;;
        go.mod|go.sum|flake.nix|flake.lock|.golangci.yml|.golangci.yaml|misc/proto/*|internal/proto/*)
            needs_precommit=true
            needs_full=true
            [[ "$path" == misc/proto/* || "$path" == internal/proto/* ]] && needs_e2e=true
            return
            ;;
        AGENTS.md|justfile|.github/*|scripts/*)
            needs_precommit=true
            needs_tooling=true
            return
            ;;
        openapi.yml)
            needs_precommit=true
            needs_schemathesis=true
            return
            ;;
        internal/adapter/http/*|internal/adapter/json/*|internal/adapter/v2/*)
            needs_precommit=true
            needs_schemathesis=true
            ;;
        tests/schemathesis/*)
            needs_precommit=true
            needs_schemathesis=true
            return
            ;;
        tests/e2e/*|pkg/testserver/*)
            needs_precommit=true
            needs_e2e=true
            return
            ;;
        tests/scenarios/*|pkg/scenario/*|misc/numscript/*)
            needs_precommit=true
            needs_scenarios=true
            return
            ;;
        misc/operator/*)
            needs_precommit=true
            needs_operator=true
            return
            ;;
        tests/antithesis/workload/*)
            needs_precommit=true
            return
            ;;
        tests/antithesis/*|tests/oracle/*)
            needs_precommit=true
            append_package "./$(dirname "$path")"
            return
            ;;
    esac

    case "$path" in
        *.go)
            needs_precommit=true
            append_package "./$(dirname "$path")"
            if [[ "$status" == D ]]; then
                needs_full=true
            fi
            case "$path" in
                main.go|internal/domain/*.go|internal/query/*.go|pkg/*.go|pkg/*/*.go)
                    needs_full=true
                    ;;
            esac
            ;;
        misc/devenv/monitoring-dashboards/*|tools/*)
            needs_precommit=true
            needs_tooling=true
            ;;
        *)
            needs_full=true
            ;;
    esac
}

while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    classify_path "$status" "$path"
done < <(git diff --no-renames --name-status --diff-filter=ACDMRTUXB -z "$base_sha" --)
while IFS= read -r -d '' path; do
    classify_path A "$path"
done < <(git ls-files --others --exclude-standard -z)

gates=()
if [[ "$needs_full" == true ]]; then
    gates+=(agent-check-full)
else
    if [[ "$needs_precommit" == true ]]; then
        gates+=(pre-commit)
    fi
    gates+=(agent-check)
    if [[ "$needs_tooling" == true ]]; then
        gates+=(test-tooling)
    else
        for package in "${changed_packages[@]}"; do
            gates+=("test-race:$package")
        done
    fi
fi
if [[ "$needs_e2e" == true ]]; then
    gates+=(test-e2e)
fi
if [[ "$needs_scenarios" == true ]]; then
    gates+=(test-scenarios)
fi
if [[ "$needs_schemathesis" == true ]]; then
    gates+=(test-schemathesis)
fi
if [[ "$needs_operator" == true ]]; then
    gates+=(test-operator)
fi

if [[ "$mode" == list ]]; then
    printf '%s\n' "${gates[@]}"
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${VALIDATION_RUN_DIR:-}" ]]; then
    exec bash "$SCRIPT_DIR/agent-validation-env" --ephemeral bash "$0" "$@"
fi

# Run selected commands in the repository-pinned toolchain. PR launchers set
# the marker only after entering the immutable base toolchain.
if [[ "${LEDGER_AGENT_CHECK_IN_NIX:-}" != "1" ]]; then
    exec env -u GOROOT nix develop --command \
        env LEDGER_AGENT_CHECK_IN_NIX=1 AI_REVIEW_BASE_SHA="$base_sha" TMPDIR="$TMPDIR" bash "$0" "$@"
fi

unset GOROOT || true
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '^/opt/homebrew' | paste -sd: -)
export PATH
bash "$SCRIPT_DIR/ai-bugfix-gate" environment "$(git rev-parse --show-toplevel)/go.mod"

if [[ -n "${VALIDATION_RUN_DIR:-}" ]]; then
    cache_root=$(cd "${LEDGER_AI_CACHE_ROOT:-}" 2>/dev/null && pwd -P) || {
        echo "SHARED_CACHE_GATE=FAIL (LEDGER_AI_CACHE_ROOT is not configured)" >&2
        exit 1
    }
    for entry in "GOCACHE:go-build" "GOMODCACHE:go-mod" "GOPATH:go-path" "XDG_CACHE_HOME:xdg" "GOLANGCI_LINT_CACHE:golangci-lint"; do
        name=${entry%%:*}
        suffix=${entry#*:}
        [[ "${!name:-}" == "$cache_root/$suffix" ]] || {
            echo "SHARED_CACHE_GATE=FAIL ($name does not use $cache_root/$suffix)" >&2
            exit 1
        }
    done
    run_root=$(cd "$VALIDATION_RUN_DIR" 2>/dev/null && pwd -P) || {
        echo "SHARED_CACHE_GATE=FAIL (invalid VALIDATION_RUN_DIR)" >&2
        exit 1
    }
    [[ "${TMPDIR:-}" == "$run_root/tmp" ]] || {
        echo "SHARED_CACHE_GATE=FAIL (TMPDIR is not run-local)" >&2
        exit 1
    }
    echo "SHARED_CACHE_GATE=PASS root=$cache_root tmp=$TMPDIR" >&2
fi

if [[ "$mode" == normalize ]]; then
    if [[ "$needs_precommit" == true || "$needs_full" == true ]]; then
        echo "==> agent-check-pr: normalization"
        bash "$SCRIPT_DIR/agent-just" pre-commit
    else
        echo "==> agent-check-pr: normalization not applicable"
    fi
    exit 0
fi

echo "==> agent-check-pr: selected local gates: ${gates[*]}"
if [[ "$needs_full" == true ]]; then
    bash "$SCRIPT_DIR/agent-check-full"
else
    if [[ "$needs_precommit" == true ]]; then
        bash "$SCRIPT_DIR/agent-just" pre-commit
    fi
    bash "$SCRIPT_DIR/agent-check"
    if [[ "$needs_tooling" == true ]]; then
        # Tooling fixtures use scripts/internal/testenv to exclude an outer
        # review binding without changing the validator's own exact identity.
        go test -race ./scripts/... -timeout 10m
    elif [[ ${#changed_packages[@]} -gt 0 ]]; then
        go test -race "${changed_packages[@]}" -timeout 10m
    fi
fi
if [[ "$needs_e2e" == true ]]; then
    bash "$SCRIPT_DIR/agent-just" test-e2e
fi
if [[ "$needs_scenarios" == true ]]; then
    bash "$SCRIPT_DIR/agent-just" test-scenarios
fi
if [[ "$needs_schemathesis" == true ]]; then
    bash "$SCRIPT_DIR/agent-just" test-schemathesis
fi
if [[ "$needs_operator" == true ]]; then
    go -C misc/operator test ./... -timeout 20m
fi

if [[ "$has_change" == false ]]; then
    echo "==> agent-check-pr: no candidate changes"
fi
echo "==> agent-check-pr: PASS"

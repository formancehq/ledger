#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bash scripts/ai-pr-loop <pr-number-or-url> [--keep-worktree] [--push]

Creates an isolated git worktree for the exact PR head, runs the base-pinned
bugfix-evidence gate when applicable, performs one proportional validation,
collects current unresolved GitHub findings once, and runs one exact final
technical review. The workflow never launches a fixer or retries the review.

By default the launcher never pushes. With --push, the exact approved candidate
is pushed only if the remote PR branch still equals the SHA observed at startup.
The launcher never comments, resolves threads, closes, or merges.

If the target branch has advanced beyond the PR's GitHub-reported base SHA,
the launcher stops before review with AI_PR_LOOP_RESULT: BASE_UPDATE_REQUIRED
(exit 3). Synchronize the PR with its target branch, then rerun the loop.
EOF
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
fi

pr=$1
shift
keep_worktree=false
push_changes=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --keep-worktree)
            keep_worktree=true
            ;;
        --push)
            push_changes=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "ai-pr-loop: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

for command in git gh jq; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "ai-pr-loop: required command not found in PATH: $command" >&2
        exit 1
    fi
done

invocation_checkout=$(git rev-parse --show-toplevel)
trusted_root_checkout=$(git -C "$invocation_checkout" worktree list --porcelain | sed -n 's/^worktree //p;q')
trusted_root_checkout=$(cd "$trusted_root_checkout" && pwd -P)
repo_root=$trusted_root_checkout
cd "$trusted_root_checkout"

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
pr_json=$(gh pr view "$pr" --repo "$repo" --json number,url,state,isDraft,title,body,labels,baseRefName,baseRefOid,headRefName,headRefOid,headRepositoryOwner,headRepository)

pr_number=$(jq -r '.number' <<<"$pr_json")
pr_url=$(jq -r '.url' <<<"$pr_json")
state=$(jq -r '.state' <<<"$pr_json")
is_draft=$(jq -r '.isDraft' <<<"$pr_json")
base_ref=$(jq -r '.baseRefName' <<<"$pr_json")
base_sha=$(jq -r '.baseRefOid' <<<"$pr_json")
head_ref=$(jq -r '.headRefName' <<<"$pr_json")
head_sha=$(jq -r '.headRefOid' <<<"$pr_json")
head_owner=$(jq -r '.headRepositoryOwner.login // empty' <<<"$pr_json")
head_repo=$(jq -r '.headRepository.name // empty' <<<"$pr_json")

if [[ "$state" != "OPEN" ]]; then
    echo "ai-pr-loop: PR #$pr_number is not open (state=$state)" >&2
    exit 1
fi
if [[ -z "$head_owner" || -z "$head_repo" ]]; then
    echo "ai-pr-loop: could not resolve PR head repository" >&2
    exit 1
fi
if [[ "$head_owner/$head_repo" != "$repo" ]]; then
    echo "ai-pr-loop: fork/cross-repository PRs are not supported yet: $head_owner/$head_repo" >&2
    exit 1
fi

remote=origin
if ! git remote get-url "$remote" >/dev/null 2>&1; then
    echo "ai-pr-loop: required git remote '$remote' is missing" >&2
    exit 1
fi

revalidate_target_or_exit() {
    local candidate_sha=${1:-}
    local revalidation_output
    local revalidation_status
    set +e
    revalidation_output=$(bash "$base_revalidator" "$remote" "$base_ref" "$base_sha" 2>&1)
    revalidation_status=$?
    set -e
    printf '%s\n' "$revalidation_output"
    case "$revalidation_status" in
        0)
            return 0
            ;;
        3)
            printf 'ai-pr-loop: target branch %s advanced during this run\n' "$base_ref" >&2
            if [[ -n "$candidate_sha" ]]; then
                printf 'CURRENT_CANDIDATE_SHA=%s\n' "$candidate_sha"
            else
                echo "CURRENT_CANDIDATE_SHA=UNAVAILABLE"
            fi
            if [[ -n "${worktree:-}" && -d "${worktree:-}" ]]; then
                printf 'CANDIDATE_WORKTREE=%s\n' "$worktree"
                keep_worktree=true
            fi
            echo "REQUIRED_NEXT_ACTION=synchronize the PR with the target branch, then rerun the full trust pipeline"
            echo "AI_PR_LOOP_RESULT: BASE_UPDATE_REQUIRED"
            exit 3
            ;;
        4)
            echo "AI_PR_LOOP_RESULT: ERROR (target base rewritten or diverged)"
            if [[ -n "${worktree:-}" && -d "${worktree:-}" ]]; then
                keep_worktree=true
            fi
            exit 1
            ;;
        *)
            echo "AI_PR_LOOP_RESULT: ERROR (target base fetch failed)"
            if [[ -n "${worktree:-}" && -d "${worktree:-}" ]]; then
                keep_worktree=true
            fi
            exit 1
            ;;
    esac
}

# The launcher establishes the startup target directly. Later refreshes use the
# helper from the base-pinned trusted-tools worktree created below.
git fetch --no-tags "$remote" "+refs/heads/$head_ref:refs/remotes/$remote/$head_ref"
fetched_head=$(git rev-parse "refs/remotes/$remote/$head_ref")
if [[ "$fetched_head" != "$head_sha" ]]; then
    echo "ai-pr-loop: fetched head SHA does not match GitHub: got $fetched_head expected $head_sha" >&2
    exit 1
fi
target_remote_ref="refs/remotes/$remote/$base_ref"
if ! git check-ref-format --branch "$base_ref" >/dev/null 2>&1 || [[ ! "$base_sha" =~ ^[0-9a-f]{40,64}$ ]]; then
    echo "AI_PR_LOOP_RESULT: ERROR (invalid target identity)"
    exit 1
fi
if ! git fetch --no-tags "$remote" "+refs/heads/$base_ref:$target_remote_ref"; then
    echo "AI_PR_LOOP_RESULT: ERROR (target base fetch failed)"
    exit 1
fi
observed_base_sha=$(git rev-parse --verify "${target_remote_ref}^{commit}")
printf 'EXPECTED_BASE_SHA=%s\n' "$base_sha"
printf 'OBSERVED_BASE_SHA=%s\n' "$observed_base_sha"
if [[ "$observed_base_sha" != "$base_sha" ]]; then
    if ! git cat-file -e "${base_sha}^{commit}" 2>/dev/null; then
        if ! git fetch --no-tags "$remote" "$base_sha"; then
            echo "BASE_REVALIDATION_CLASSIFICATION=FETCH_ERROR"
            echo "AI_PR_LOOP_RESULT: ERROR (target base fetch failed)"
            exit 1
        fi
    fi
    if ! git merge-base --is-ancestor "$base_sha" "$observed_base_sha" && [[ "$(git rev-parse --is-shallow-repository)" == "true" ]]; then
        if ! git fetch --no-tags --unshallow "$remote" "$observed_base_sha"; then
            echo "BASE_REVALIDATION_CLASSIFICATION=FETCH_ERROR"
            echo "AI_PR_LOOP_RESULT: ERROR (target base fetch failed)"
            exit 1
        fi
    fi
    if git merge-base --is-ancestor "$base_sha" "$observed_base_sha"; then
        echo "BASE_REVALIDATION_CLASSIFICATION=ADVANCED"
        echo "AI_PR_LOOP_RESULT: BASE_UPDATE_REQUIRED"
        exit 3
    fi
    echo "BASE_REVALIDATION_CLASSIFICATION=REWRITTEN_OR_DIVERGED"
    echo "AI_PR_LOOP_RESULT: ERROR (target base rewritten or diverged)"
    exit 1
fi
echo "BASE_REVALIDATION_CLASSIFICATION=UNCHANGED"

repo_parent=$(dirname "$repo_root")
repo_name=$(basename "$repo_root")
worktree_parent="$repo_parent/.${repo_name}-ai-worktrees"
mkdir -p "$worktree_parent"
worktree_run_dir=$(mktemp -d "$worktree_parent/pr-$pr_number.XXXXXX")
worktree="$worktree_run_dir/worktree"
trusted_tool_worktree="$worktree_run_dir/trusted-tools"
validation_run_dir="$worktree_run_dir/validation"
review_loop_binary=""
rootguard_binary=""

cleanup() {
    exit_status=$?
    trap - EXIT
    primary_status=$exit_status
    if [[ -d "$trusted_tool_worktree" ]] && git -C "$trusted_tool_worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git worktree remove "$trusted_tool_worktree" >/dev/null 2>&1 || true
    fi
    if [[ -n "$review_loop_binary" ]] && [[ "$review_loop_binary" == "$worktree_run_dir/review-loop" ]]; then
        rm -f -- "$review_loop_binary"
    fi
    if [[ -n "$rootguard_binary" ]] && [[ "$rootguard_binary" == "$worktree_run_dir/rootguard" ]]; then
        rm -f -- "$rootguard_binary"
    fi
    if [[ "$keep_worktree" == false ]]; then
        # The loop runs from inside the worktree that is about to be removed;
        # leave it first so removal never operates on the current directory.
        cd "$repo_root" || true
        if [[ -d "$worktree" ]] && git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            if [[ -z "$(git -C "$worktree" status --porcelain 2>/dev/null || true)" ]]; then
                git worktree remove "$worktree" >/dev/null 2>&1 || true
            fi
        fi
        # Validation keeps only temporary files in the run directory. Shared
        # caches live outside it and survive cleanup.
        if [[ ! -e "$worktree" && ! -e "$trusted_tool_worktree" ]] &&
            [[ "$worktree_run_dir" == "$worktree_parent/pr-$pr_number."?????? ]]; then
            # Cleanup warnings must not overwrite the primary validation result.
            if ! rm -rf -- "$worktree_run_dir"; then
                echo "VALIDATION_CLEANUP=WARNING path=$worktree_run_dir" >&2
            fi
        else
            rmdir "$worktree_run_dir" >/dev/null 2>&1 || true
        fi
    fi
    exit "$primary_status"
}
trap cleanup EXIT

git worktree add --detach "$worktree" "$head_sha"
git worktree add --detach "$trusted_tool_worktree" "$base_sha"
mkdir -p "$validation_run_dir"
metadata_file="$worktree_run_dir/pr-metadata.json"
printf '%s\n' "$pr_json" >"$metadata_file"

expected_worktree_head=$head_sha
base_revalidator="$trusted_tool_worktree/scripts/ai-target-base-revalidate"
if [[ -L "$base_revalidator" || ! -f "$base_revalidator" || ! -r "$base_revalidator" ]]; then
    echo "ai-pr-loop: trusted base does not provide scripts/ai-target-base-revalidate" >&2
    exit 1
fi
bugfix_gate="$trusted_tool_worktree/scripts/ai-bugfix-gate"
known_findings_tool="$trusted_tool_worktree/scripts/ai-pr-known-findings"
for trusted_tool in "$bugfix_gate" "$known_findings_tool"; do
    if [[ -L "$trusted_tool" || ! -f "$trusted_tool" || ! -r "$trusted_tool" ]]; then
        echo "ai-pr-loop: trusted base does not provide readable non-symlink regular file ${trusted_tool#"$trusted_tool_worktree/"}" >&2
        exit 1
    fi
done

intent=non-bugfix
pr_title=$(jq -r '.title // ""' "$metadata_file")
pr_body=$(jq -r '.body // ""' "$metadata_file")
if jq -e '.labels[]?.name | ascii_downcase == "bugfix" or ascii_downcase == "bug-fix"' "$metadata_file" >/dev/null || \
   [[ "$pr_title" == fix:* || "$pr_title" == Fix:* || "$pr_title" == fix\(*\):* || "$pr_title" == Fix\(*\):* ]] || \
   grep -Eiq '(^|[[:space:]])(fixes|fix|resolves)[[:space:]]+EN-[0-9]+' <<<"$pr_body"; then
    intent=bugfix
fi
printf '%s\n' "$intent" >"$worktree_run_dir/bugfix-intent"
printf '%s\n' "$pr_body" >"$worktree_run_dir/bugfix-evidence.txt"
if ! bash "$bugfix_gate" evidence "$worktree_run_dir/bugfix-evidence.txt" "$intent"; then
    echo "AI_PR_LOOP_RESULT: ERROR (bugfix evidence rejected)"
    exit 1
fi

known_findings="$worktree_run_dir/known-findings.json"
export AI_REVIEW_KNOWN_FINDINGS="$known_findings"
export AI_REVIEW_KNOWN_FINDINGS_PR="$pr_number"
export AI_REVIEW_KNOWN_FINDINGS_HEAD="$head_sha"
export AI_REVIEW_CONTEXT="$metadata_file"
review_context_digest=$(git hash-object -- "$metadata_file")

if ! command -v nix >/dev/null 2>&1; then
    echo "ai-pr-loop: required command not found in PATH: nix" >&2
    exit 1
fi

# Build the orchestrator and outer root-integrity runner from the verified base.
review_loop_binary="$worktree_run_dir/review-loop"
rootguard_binary="$worktree_run_dir/rootguard"
for trusted_tool in ai-review-codex; do
    trusted_tool_path="$trusted_tool_worktree/scripts/$trusted_tool"
    if [[ ! -x "$trusted_tool_path" ]]; then
        echo "ai-pr-loop: trusted base does not provide executable scripts/$trusted_tool" >&2
        exit 1
    fi
done
for trusted_tool in agent-validation-env agent-check-pr agent-just; do
    trusted_tool_path="$trusted_tool_worktree/scripts/$trusted_tool"
    if [[ -L "$trusted_tool_path" || ! -f "$trusted_tool_path" || ! -r "$trusted_tool_path" ]]; then
        echo "ai-pr-loop: trusted base does not provide readable non-symlink regular file scripts/$trusted_tool" >&2
        exit 1
    fi
done
nix develop "path:$trusted_tool_worktree" --command \
    env -u GOROOT bash -c \
    'set -euo pipefail; go -C "$1" build -o "$2" ./scripts/reviewloop; go -C "$1" build -o "$3" ./scripts/rootguard' \
    bash "$trusted_tool_worktree" "$review_loop_binary" "$rootguard_binary"
review_loop=("$review_loop_binary")
printf -v review_cmd 'bash %q' "$trusted_tool_worktree/scripts/ai-review-codex"
# review-loop executes validation through `bash -c`. Quote every base-pinned
# path so spaces or shell metacharacters cannot change the command.
printf -v quoted_run_dir %q "$validation_run_dir"
printf -v quoted_validation_env %q "$trusted_tool_worktree/scripts/agent-validation-env"
printf -v quoted_validation_tool %q "$trusted_tool_worktree/scripts/agent-check-pr"
printf -v validation_program \
    'env LEDGER_AGENT_CHECK_IN_NIX=1 bash %s %s bash %s' \
    "$quoted_validation_env" "$quoted_run_dir" "$quoted_validation_tool"
printf -v validation_cmd 'env -u GOROOT nix develop %q --command bash -c %q' \
    "path:$trusted_tool_worktree" "$validation_program"
printf -v known_findings_cmd \
    'bash %q %q --head %q --output %q && printf "==> ai-pr-loop: %%s unresolved GitHub review finding(s)\\n" "$(jq ".findings | length" %q)"' \
    "$known_findings_tool" "$pr_number" "$head_sha" "$known_findings" "$known_findings"

printf '==> ai-pr-loop: PR #%s\n' "$pr_number"
printf '    URL: %s\n' "$pr_url"
printf '    base: %s (%s)\n' "$base_ref" "$base_sha"
printf '    head: %s (%s)\n' "$head_ref" "$head_sha"
printf '    worktree: %s\n' "$worktree"
if [[ "$is_draft" == "true" ]]; then
    echo "    note: PR is currently draft"
fi
if [[ "$push_changes" == "true" ]]; then
    echo "    publish: guarded commit + push enabled"
fi

run_final_review() {
    env -C "$worktree" "$rootguard_binary" --root "$trusted_root_checkout" -- "${review_loop[@]}" \
        --base "$base_sha" \
        --pr "$pr_number" \
        --worktree "$worktree" \
        --expected-head "$expected_worktree_head" \
        --trusted-root "$trusted_root_checkout" \
        --validation-run-dir "$validation_run_dir" \
        --state-dir "$worktree_run_dir/review-state" \
        --review-cmd "$review_cmd" \
        --validation-cmd "$validation_cmd" \
        --known-findings-cmd "$known_findings_cmd" \
        --known-findings-file "$known_findings"
}

# The final reviewer runs with immutable task context. A run whose context moved
# cannot be reported as reviewed.
verify_review_inputs() {
    local current_digest
    current_digest=$(git hash-object -- "$metadata_file")
    if [[ "$current_digest" != "$review_context_digest" ]]; then
        echo "ai-pr-loop: review context changed while agents were running" >&2

        return 1
    fi
}

verify_remote_pr_head() {
    local current_pr_json
    local current_pr_head
    if ! current_pr_json=$(gh pr view "$pr_number" --repo "$repo" --json headRefOid); then
        echo "ai-pr-loop: could not re-read the PR head after review" >&2
        return 1
    fi
    if ! current_pr_head=$(jq -er '.headRefOid | select(type == "string" and length > 0)' <<<"$current_pr_json"); then
        echo "ai-pr-loop: re-read PR metadata does not contain a valid head" >&2
        return 1
    fi
    if [[ "$current_pr_head" != "$head_sha" ]]; then
        printf 'ai-pr-loop: PR head moved during review: expected %s got %s\n' "$head_sha" "$current_pr_head" >&2
        return 1
    fi
}

set +e
run_final_review
loop_status=$?
set -e

cd "$worktree"

if ! verify_review_inputs; then
    echo "AI_PR_LOOP_RESULT: ERROR (review inputs modified)"
    keep_worktree=true
    exit 1
fi
if ! verify_remote_pr_head; then
    echo "AI_PR_LOOP_RESULT: ERROR (PR head moved during review)"
    keep_worktree=true
    exit 1
fi

echo
case "$loop_status" in
    0)
        if [[ "$push_changes" == "false" ]]; then
            # A startup check cannot authorize readiness after review.
            revalidate_target_or_exit
            echo "AI_PR_LOOP_RESULT: READY_FOR_HUMAN_REVIEW"
        else
            echo "AI_PR_LOOP_REVIEW_RESULT: APPROVE"
        fi
        ;;
    2)
        echo "AI_PR_LOOP_REVIEW_RESULT: FINDINGS"
        echo "AI_PR_LOOP_RESULT: NOT_READY"
        echo "Candidate worktree preserved for engineering fixes: $worktree"
        keep_worktree=true
        ;;
    4) echo "AI_PR_LOOP_RESULT: VALIDATION_FAILED" ;;
    *) echo "AI_PR_LOOP_RESULT: REVIEW_FAILED" ;;
esac

if [[ "$loop_status" -ne 0 ]]; then
    exit "$loop_status"
fi

if [[ "$push_changes" == "false" ]]; then
    if [[ -n "$(git status --porcelain)" ]]; then
        echo "Candidate worktree is dirty; preserved for inspection: $worktree"
        keep_worktree=true
    else
        echo "Worktree is clean."
    fi
    exit 0
fi

candidate_sha=$(git rev-parse HEAD)
printf '==> ai-pr-loop: candidate commit %s\n' "$candidate_sha"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "ai-pr-loop: candidate review left the worktree dirty; refusing push" >&2
    echo "Candidate worktree preserved for inspection: $worktree"
    keep_worktree=true
    exit 1
fi

current_head=$(git rev-parse HEAD)
if [[ "$current_head" != "$candidate_sha" ]]; then
    echo "AI_PR_LOOP_PUSH_RESULT: REFUSED (reviewed candidate HEAD changed)"
    echo "Reviewed: $candidate_sha"
    echo "Current:  $current_head"
    echo "Candidate worktree preserved for inspection: $worktree"
    keep_worktree=true
    exit 1
fi

if ! git merge-base --is-ancestor "$head_sha" "$candidate_sha"; then
    echo "ai-pr-loop: candidate commit is not a descendant of the original PR head" >&2
    keep_worktree=true
    exit 1
fi

# Keep the last target fetch immediately adjacent to the guarded push. The PR
# head lease remains the atomic guard for the independently mutable head ref.
revalidate_target_or_exit "$candidate_sha"

remote_head=""
read -r remote_head _ < <(git ls-remote --exit-code "$remote" "refs/heads/$head_ref") || true
if [[ -z "$remote_head" ]]; then
    echo "ai-pr-loop: could not resolve current remote PR head" >&2
    keep_worktree=true
    exit 1
fi
if [[ "$remote_head" != "$head_sha" ]]; then
    echo "AI_PR_LOOP_PUSH_RESULT: REFUSED (remote PR head moved)"
    echo "Expected: $head_sha"
    echo "Current:  $remote_head"
    echo "Candidate worktree preserved for inspection: $worktree"
    keep_worktree=true
    exit 2
fi

if ! git push \
    --force-with-lease="refs/heads/$head_ref:$head_sha" \
    "$remote" \
    "$candidate_sha:refs/heads/$head_ref"; then
    echo "AI_PR_LOOP_PUSH_RESULT: REFUSED (remote changed during push or push failed)"
    echo "Candidate worktree preserved for inspection: $worktree"
    keep_worktree=true
    exit 2
fi

echo "AI_PR_LOOP_RESULT: READY_FOR_HUMAN_REVIEW"
echo "AI_PR_LOOP_PUSH_RESULT: PUSHED $candidate_sha"
exit 0

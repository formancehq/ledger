#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bash scripts/ai-pr-known-findings <pr-number> --head <sha> --output <path>

Collects current unresolved GitHub review findings for one exact PR head.
EOF
}

[[ $# -gt 0 ]] || { usage >&2; exit 1; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
pr=$1
shift
head=""
output=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --head) [[ $# -ge 2 ]] || { usage >&2; exit 1; }; head=$2; shift 2 ;;
        --output) [[ $# -ge 2 ]] || { usage >&2; exit 1; }; output=$2; shift 2 ;;
        *) echo "ai-pr-known-findings: unknown argument: $1" >&2; exit 1 ;;
    esac
done
[[ "$pr" =~ ^[1-9][0-9]*$ ]] || { echo "ai-pr-known-findings: invalid PR number" >&2; exit 1; }
[[ "$head" =~ ^[0-9a-f]{40,64}$ ]] || { echo "ai-pr-known-findings: --head must be a full SHA" >&2; exit 1; }
[[ -n "$output" ]] || { echo "ai-pr-known-findings: --output is required" >&2; exit 1; }
for cmd in gh jq; do command -v "$cmd" >/dev/null 2>&1 || { echo "ai-pr-known-findings: missing $cmd" >&2; exit 1; }; done

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
owner=${repo%%/*}
name=${repo#*/}
actual_head=$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid)
if [[ "$actual_head" != "$head" ]]; then
    echo "ai-pr-known-findings: PR head moved: expected $head got $actual_head" >&2
    exit 2
fi

thread_pages=$(mktemp)
reviews=$(mktemp)
result=""
cleanup() {
    rm -f -- "$thread_pages" "$reviews"
    [[ -z "$result" ]] || rm -f -- "$result"
}
trap cleanup EXIT

query='query($owner:String!,$name:String!,$number:Int!,$endCursor:String){
  repository(owner:$owner,name:$name){
    pullRequest(number:$number){
      reviewDecision
      reviewThreads(first:100,after:$endCursor){
        nodes{
          id isResolved isOutdated path line originalLine
          comments(first:100){nodes{
            databaseId url body author{login}
            pullRequestReview{databaseId}
          }}
        }
        pageInfo{hasNextPage endCursor}
      }
    }
  }
}'

gh api graphql --paginate --slurp \
    -f query="$query" \
    -F owner="$owner" \
    -F name="$name" \
    -F number="$pr" >"$thread_pages"
gh api --paginate "repos/$repo/pulls/$pr/reviews?per_page=100" --slurp >"$reviews"

output_dir=$(dirname -- "$output")
mkdir -p "$output_dir"
result=$(mktemp "$output_dir/.ai-pr-known-findings.XXXXXX")

jq -n \
    --argjson pr "$pr" \
    --arg head "$head" \
    --slurpfile thread_pages "$thread_pages" \
    --slurpfile review_pages "$reviews" '
  def flatpages($x): $x | flatten;
  def structured_review_parts:
    . as $body |
    [ $body | match("(?m)^\\[P[0-3]\\]\\[blocking\\]"; "g") ] as $markers |
    if ($markers | length) == 0 then []
    else [ range(0; ($markers | length)) as $index |
      ($markers[$index].offset) as $start |
      (if ($index + 1) < ($markers | length)
       then $markers[$index + 1].offset
       else ($body | length)
       end) as $end |
      $body[$start:$end]
    ] end;
  (flatpages($thread_pages)) as $pages |
  ($pages | map(.data.repository.pullRequest.reviewThreads.nodes) | add // []) as $threads |
  ($pages[0].data.repository.pullRequest.reviewDecision // "") as $review_decision |
  ([ $threads[].comments.nodes[].pullRequestReview.databaseId ] | unique) as $reviews_with_threads |
  ([ $threads[] | select(.isResolved == false) | select((.comments.nodes | length) > 0) |
    . as $thread | .comments.nodes[0] as $first |
    {
      id: ("github-review-thread-" + $thread.id),
      kind: "unresolved-review-thread",
      url: ($first.url // ""),
      author: ($first.author.login // ""),
      path: ($thread.path // ""),
      line: ($thread.line // null),
      original_line: ($thread.originalLine // null),
      is_outdated: ($thread.isOutdated // false),
      body: ($thread.comments.nodes | map("@" + (.author.login // "unknown") + ": " + (.body // "")) | join("\n\n"))
    }
  ]) as $thread_findings |
  (flatpages($review_pages)) as $reviews |
  (if $review_decision == "CHANGES_REQUESTED" then
    [ $reviews[] |
      select(.state == "CHANGES_REQUESTED") |
      select((.body // "") | length > 0) |
      select(.id as $id | ($reviews_with_threads | index($id)) == null) |
      . as $review |
      (($review.body // "") | structured_review_parts) as $parts |
      if ($parts | length) > 0 then
        ($parts | to_entries[] | {
          id: ("github-review-" + ($review.id|tostring) + "-finding-" + ((.key + 1)|tostring)),
          kind: "review-body-finding",
          url: ($review.html_url // ""),
          author: ($review.user.login // ""),
          path: "",
          line: null,
          original_line: null,
          is_outdated: false,
          body: .value
        })
      else
        {
          id: ("github-review-" + ($review.id|tostring)),
          kind: "review-body",
          url: ($review.html_url // ""),
          author: ($review.user.login // ""),
          path: "",
          line: null,
          original_line: null,
          is_outdated: false,
          body: ($review.body // "")
        }
      end
    ]
  else [] end) as $legacy_findings |
  {
    version: 1,
    pr_number: $pr,
    head: $head,
    review_decision: $review_decision,
    findings: (($thread_findings + $legacy_findings) | sort_by(.id))
  }
' >"$result"

jq -e --arg head "$head" --argjson pr "$pr" '
  .version == 1 and .pr_number == $pr and .head == $head and
  (.review_decision | type == "string") and
  (.findings | type == "array") and
  ([.findings[].id] | length == (unique | length)) and
  all(.findings[];
    (.id | type == "string" and length > 0) and
    (.kind == "unresolved-review-thread" or .kind == "review-body" or .kind == "review-body-finding") and
    (.url | type == "string") and (.author | type == "string") and (.path | type == "string") and
    ((.line | type) == "null" or (.line | type) == "number") and
    ((.original_line | type) == "null" or (.original_line | type) == "number") and
    (.is_outdated | type == "boolean") and
    (.body | type == "string" and length > 0)
  )
' "$result" >/dev/null

actual_head=$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid)
if [[ "$actual_head" != "$head" ]]; then
    echo "ai-pr-known-findings: PR head moved during collection: expected $head got $actual_head" >&2
    exit 2
fi

mv -- "$result" "$output"
result=""
printf 'AI_PR_KNOWN_FINDINGS_COUNT: %s\n' "$(jq '.findings | length' "$output")"
printf 'AI_PR_KNOWN_FINDINGS_RESULT: %s\n' "$output"

+/// Close the exact terminal imports emitted by the pinned preview1 adapter.
+pub(crate) fn stub_closed_terminal_virt(module: &mut Module) -> Result<()> {
+    let memory = module
+        .memories
+        .iter()
+        .next()
+        .context("virtual adapter does not export a memory")?
+        .id();
+    let imports = [
+        ("wasi:cli/terminal-stdin@0.2.12", "get-terminal-stdin", true),
+        ("wasi:cli/terminal-stdout@0.2.12", "get-terminal-stdout", true),
+        ("wasi:cli/terminal-stderr@0.2.12", "get-terminal-stderr", true),
+        (
+            "wasi:cli/terminal-input@0.2.12",
+            "[resource-drop]terminal-input",
+            false,
+        ),
+        (
+            "wasi:cli/terminal-output@0.2.12",
+            "[resource-drop]terminal-output",
+            false,
+        ),
+    ];
+    for (module_name, func_name, writes_none) in imports {
+        let fid = module
+            .imports
+            .get_func(module_name, func_name)
+            .with_context(|| {
+                format!("missing closed terminal import [{func_name}] in module [{module_name}]")
+            })?;
+        {
+            let function = module.funcs.get(fid);
+            let FunctionKind::Import(imported) = &function.kind else {
+                bail!("closed terminal function [{func_name}] is not an import");
+            };
+            let ty = module.types.get(imported.ty);
+            if ty.params() != [ValType::I32] || !ty.results().is_empty() {
+                bail!(
+                    "closed terminal import [{func_name}] in module [{module_name}] has an unexpected signature"
+                );
+            }
+        }
+        module
+            .replace_imported_func(fid, |(body, args)| {
+                if writes_none {
+                    body.local_get(args[0]);
+                    body.i32_const(0);
+                    body.instr(Store {
+                        memory,
+                        kind: StoreKind::I32 { atomic: false },
+                        arg: MemArg {
+                            align: 4,
+                            offset: 0,
+                        },
+                    });
+                }
+            })
+            .with_context(|| {
+                format!(
+                    "failed to close terminal import [{func_name}] in module [{module_name}]"
+                )
+            })?;
+    }
+    Ok(())
+}
